# Copy this file to .env and fill it in.

# ── Discord (required) ────────────────────────────────────────────
DISCORD_TOKEN=
# Your server ID: commands appear instantly there. Leave empty to register globally (up to 1h).
GUILD_ID=

# ── Spotify (optional, enables albums/playlists) ──────────────────
# https://developer.spotify.com/dashboard → Create app. Without these, single Spotify
# tracks still work (by name), but albums/playlists don't.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Notifications ─────────────────────────────────────────────────
# Where weather / calendar notifications go (set one or both).
NOTIFY_CHANNEL_ID=
OWNER_USER_ID=

# Google Calendar → Settings → your calendar → "Secret address in iCal format"
ICAL_URL=
# Minutes before an event to remind you
REMIND_BEFORE_MIN=15

# ── Weather ───────────────────────────────────────────────────────
HOME_CITY="Hà Nội"
HOME_LAT=21.0285
HOME_LON=105.8542
MORNING_TIME=06:30
TIMEZONE=Asia/Ho_Chi_Minh

# ── Voice (text to speech) ────────────────────────────────────────
# Other Vietnamese voice: Microsoft Server Speech Text to Speech Voice (vi-VN, NamMinhNeural)
TTS_VOICE="Microsoft Server Speech Text to Speech Voice (vi-VN, HoaiMyNeural)"
# Semitones higher than normal (0 = natural voice, 2–4 = cute, 6+ = chipmunk)
TTS_PITCH=2.5
# Speaking speed (1.0 = normal)
TTS_SPEED=1.05

# ── Music ─────────────────────────────────────────────────────────
# When the queue runs out, play related songs (true/false). Per server: /autoplay,
# or the autoplay option of /play.
AUTOPLAY=true

DATABASE_PATH=data/dapan.db

# ── Local voice (VieNeu-TTS on your GPU, see README) ──────────────
# When set, Dapan uses the local server first and Edge only as a fallback.
TTS_LOCAL_URL=http://127.0.0.1:5005
# Preset (e.g. Mai Anh, Trúc Ly, Ngọc Huyền) or a cloned voice name from tts-server/voices
TTS_LOCAL_VOICE="Trúc Ly"
